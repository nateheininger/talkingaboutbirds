---
import Base from '../layouts/Base.astro';
import ListenButtons from '../components/ListenButtons.astro';
import { getShow } from '../lib/feed';
import { SITE, HOSTS, SOCIAL, PATREON_URL } from '../site.config';
import { url, episodePath } from '../lib/urls';
import { podcastSeries, breadcrumbs } from '../lib/schema';
import { formatDate } from '../lib/text';

const show = await getShow();
const first = show.episodes.at(-1)!;
const latest = show.episodes[0];
---

<Base
  title="About Talking About Birds, a St. Louis Cardinals Podcast"
  description={`About Talking About Birds, the weekly St. Louis Cardinals podcast hosted by ${HOSTS.map((h) => h.name).join(' and ')}. How to listen, contact the show, and support it.`}
  path="/about/"
  jsonLd={[podcastSeries(show.episodes.length), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }])]}
>
  <div class="wrap narrow page">
    <h1>About the show</h1>
    <p class="lede">{SITE.tagline}</p>
    <p>
      <strong>Talking About Birds</strong> is a weekly podcast mostly about the St. Louis Cardinals, hosted by
      {HOSTS.map((h, i) => <>{i > 0 && ' and '}<strong>{h.name}</strong></>)}. Since
      <a href={url(episodePath(first))}>episode 1</a> on {formatDate(first.pubDate)}, we've put out
      {show.episodes.length} episodes: season previews and autopsies, player-by-player breakdowns, prospect talk, trade
      deadline reactions, and recurring segments like Who Charted?
    </p>
    <p>The newest episode is <a href={url(episodePath(latest))}>{latest.title}</a>.</p>

    <h2>The hosts</h2>
    <div class="hosts">
      {
        HOSTS.map((h) => (
          <section class="card host">
            <h3>{h.name}</h3>
            <p class="eyebrow">{h.role}</p>
            <p>{h.bio}</p>
          </section>
        ))
      }
    </div>

    <h2>Listen</h2>
    <p>Subscribe wherever you get podcasts, or grab the RSS feed directly.</p>
    <ListenButtons />

    <h2>Get in touch</h2>
    <ul>
      <li>Text or voicemail: <a href={`tel:${SITE.phone.digits}`}>{SITE.phone.display}</a></li>
      <li>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      {SOCIAL.map((s) => <li><a href={s.url} rel="me noopener">{s.name}</a></li>)}
    </ul>

    <h2>Support the show</h2>
    <p>
      Talking About Birds is listener supported. <a href={PATREON_URL} rel="noopener">Join us on Patreon</a> to support the
      show and get into our private Discord.
    </p>
  </div>
</Base>

<style>
  .page { padding-top: 2.5rem; }
  .lede { font-size: 1.25rem; font-weight: 700; }
  h2 { margin-top: 2.5rem; }
  .hosts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .host { padding: 1.25rem; }
  .host p:last-child { margin-bottom: 0; }
  @media (max-width: 640px) { .hosts { grid-template-columns: 1fr; } }
</style>
