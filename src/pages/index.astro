---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import ListenButtons from '../components/ListenButtons.astro';
import { getShow } from '../lib/feed';
import { SITE, PATREON_URL } from '../site.config';
import { url, episodePath } from '../lib/urls';
import { formatDate, formatDuration } from '../lib/text';
import { podcastSeries, website } from '../lib/schema';

const show = await getShow();
const [latest, ...rest] = show.episodes;
const recent = rest.slice(0, 6);
const firstYear = show.episodes.at(-1)!.pubDate.getFullYear();
const totalHours = Math.round(show.episodes.reduce((n, e) => n + e.durationSeconds, 0) / 3600);
---

<Base
  title="Talking About Birds: A St. Louis Cardinals Podcast"
  description={SITE.description}
  path="/"
  jsonLd={[website(), podcastSeries(show.episodes.length)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">A weekly St. Louis Cardinals podcast</p>
        <h1>Talking About Birds</h1>
        <p class="lede">{SITE.tagline}</p>
        <p>
          Nate Heininger and Ben Simorka break down the St. Louis Cardinals every week: the roster, the prospects,
          the trades, the front office, and whatever else comes up along the way.
        </p>
        <ListenButtons only={['Apple Podcasts', 'Spotify', 'YouTube']} />
        <ul class="stats" aria-label="Show stats">
          <li><strong>{show.episodes.length}</strong> episodes</li>
          <li><strong>{totalHours}+</strong> hours</li>
          <li><strong>{firstYear}</strong> first episode</li>
        </ul>
      </div>
      <img
        class="cover"
        src={url('/cover.png')}
        width="640"
        height="640"
        alt="Talking About Birds artwork: pixel-art Nate and Ben in front of the Gateway Arch"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Latest episode</h2></div>
      <article class="card latest">
        <p class="eyebrow">
          Episode {latest.number} · <time datetime={latest.pubDate.toISOString()}>{formatDate(latest.pubDate)}</time> ·
          {formatDuration(latest.durationSeconds)}
        </p>
        <h3 class="latest-title"><a href={url(episodePath(latest))}>{latest.title}</a></h3>
        <div class="prose" set:html={latest.descriptionHtml} />
        <audio controls preload="none" src={latest.audioUrl}>
          <a href={latest.audioUrl}>Download the episode (MP3)</a>
        </audio>
        <p class="latest-links">
          <a class="btn btn--plain" href={url(episodePath(latest))}>Episode page &amp; notes</a>
        </p>
      </article>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Recent episodes</h2>
        <a href={url('/episodes/')}>All {show.episodes.length} episodes →</a>
      </div>
      <div class="grid">{recent.map((ep) => <EpisodeCard episode={ep} />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta-grid">
      <div class="card cta">
        <h2>Call the bird phone</h2>
        <p>
          Question, comment, hot take, or opening bit? Text or leave us a voicemail and you might end up on the show.
        </p>
        <p><a class="btn" href={`tel:${SITE.phone.digits}`}>{SITE.phone.display}</a></p>
      </div>
      <div class="card cta">
        <h2>Support the show</h2>
        <p>
          Talking About Birds is listener supported. Back the show on Patreon and get into our private Discord.
        </p>
        <p><a class="btn btn--plain" href={PATREON_URL} rel="noopener">Support on Patreon</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--navy);
    color: #fff;
    padding: 3.5rem 0 3.75rem;
  }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: center; }
  .hero h1 { color: #fff; font-size: clamp(2.8rem, 7vw, 4.6rem); margin-bottom: 0.3em; }
  .hero-eyebrow { color: #f1a3b3; }
  .lede { font-size: 1.3rem; font-weight: 600; margin: 0 0 0.75rem; }
  .hero p { max-width: 36rem; color: #d7dce6; }
  .hero .lede { color: #fff; }
  .hero :global(.listen) { margin-top: 1.75rem; }
  /* Secondary listen buttons read as outlines on the navy background */
  .hero :global(.btn--plain) { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.35); }
  .hero :global(.btn--plain:hover) { border-color: #fff; }
  .cover {
    width: 100%; max-width: 400px; justify-self: end;
    border-radius: 16px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }
  .stats { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; gap: 2rem; flex-wrap: wrap; font-size: 0.95rem; color: #aab3c5; }
  .stats strong { display: block; font: 700 1.9rem/1 var(--font-display); color: #fff; }

  .latest { padding: 1.75rem; }
  .latest-title { font-size: 1.5rem; }
  .latest-title a { color: var(--text); text-decoration: none; }
  .latest-title a:hover { color: var(--accent-text); }
  .latest audio { margin: 1.25rem 0 1rem; }
  .latest-links { margin: 0; }

  .alt { background: var(--surface-2); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }

  .cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .cta { padding: 1.75rem; }
  .cta p:last-child { margin-bottom: 0; }

  @media (max-width: 760px) {
    .hero { padding: 2rem 0 2.5rem; }
    .hero-grid, .cta-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .cover { justify-self: start; max-width: 140px; order: -1; border-radius: 12px; }
    .stats { gap: 1.5rem; }
  }
</style>
