---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { SITE, SOCIAL, PATREON_URL, ANALYTICS } from '../site.config';
import { url, absoluteUrl, isProductionSite } from '../lib/urls';

interface Props {
  title: string; // full <title>; keep under ~60 characters where possible
  description: string;
  path: string; // canonical path, e.g. "/episodes/241-foo/"
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description, path, type = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
const image = absoluteUrl('/artwork.jpg');
const robots = noindex || !isProductionSite ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const current = Astro.url.pathname;
const nav = [
  { href: url('/episodes/'), label: 'Episodes' },
  { href: url('/players/'), label: 'Players' },
  { href: url('/about/'), label: 'About' },
  { href: url('/listen/'), label: 'Listen' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#bf1d3e" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.fullName} href={SITE.feedUrl} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Talking About Birds podcast artwork: pixel-art hosts in front of the St. Louis Arch" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {ANALYTICS.googleSiteVerification && <meta name="google-site-verification" content={ANALYTICS.googleSiteVerification} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      isProductionSite && ANALYTICS.goatcounterCode && (
        <script
          is:inline
          data-goatcounter={`https://${ANALYTICS.goatcounterCode}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label="Talking About Birds home">
          <img src={url('/favicon.png')} alt="" width="36" height="36" />
          <span>Talking About Birds</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a class="btn nav-cta" href={PATREON_URL} rel="noopener">Patreon</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Talking About Birds</p>
          <p>{SITE.tagline} A weekly podcast mostly about the St. Louis Cardinals.</p>
          <p>
            Text or leave a voicemail: <a href={`tel:${SITE.phone.digits}`}>{SITE.phone.display}</a><br />
            Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <nav aria-label="Social">
          <p class="footer-head">Follow</p>
          <ul>{SOCIAL.map((s) => <li><a href={s.url} rel="me noopener">{s.name}</a></li>)}</ul>
        </nav>
        <nav aria-label="Site">
          <p class="footer-head">Site</p>
          <ul>
            <li><a href={url('/episodes/')}>All episodes</a></li>
            <li><a href={url('/players/')}>Players</a></li>
            <li><a href={url('/about/')}>About the show</a></li>
            <li><a href={url('/listen/')}>Where to listen</a></li>
            <li><a href={SITE.feedUrl}>RSS feed</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap fine">© {year} Nate Heininger &amp; Ben Simorka. Not affiliated with the St. Louis Cardinals or MLB.</div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed; left: 1rem; top: 1rem; width: auto; height: auto; clip: auto;
    padding: 0.5rem 1rem; background: var(--surface); color: var(--text); z-index: 10;
    border: 2px solid var(--red); border-radius: var(--radius-sm);
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 4rem; flex-wrap: wrap; padding-block: 0.5rem;
  }
  .brand {
    display: flex; align-items: center; gap: 0.6rem;
    color: var(--text); text-decoration: none;
    font: 700 1.45rem/1 var(--font-display);
  }
  .brand img { border-radius: 8px; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  .bar nav ul { display: flex; align-items: center; gap: 0.25rem 1.4rem; flex-wrap: wrap; }
  .bar nav a:not(.btn) {
    color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.97rem;
    padding: 0.3rem 0; border-bottom: 2px solid transparent;
  }
  .bar nav a:not(.btn):hover { color: var(--accent-text); }
  .bar nav a[aria-current='page'] { border-bottom-color: var(--red); }
  .nav-cta { padding: 0.5em 0.9em; font-size: 0.9rem; }

  .site-footer {
    margin-top: 4rem;
    background: var(--navy);
    color: #c9cfdc;
    padding: 2.75rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .site-footer a { color: #fff; }
  .footer-grid { display: grid; gap: 2rem; grid-template-columns: 2fr 1fr 1fr; }
  .footer-brand { font: 700 1.6rem/1 var(--font-display); color: #fff; margin: 0 0 0.75rem; }
  .footer-head { font-weight: 600; color: #fff; margin: 0 0 0.5rem; }
  .site-footer li { margin-bottom: 0.3rem; }
  .fine { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--navy-2); color: #98a1b5; font-size: 0.85rem; }
  @media (max-width: 520px) {
    .bar { gap: 0.6rem; }
    .bar nav ul { gap: 0.25rem 0.9rem; }
    .bar nav a:not(.btn) { font-size: 0.93rem; }
    .nav-cta { font-size: 0.82rem; padding: 0.4em 0.7em; }
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-grid > div:first-child { grid-column: 1 / -1; }
    .brand { font-size: 1.3rem; }
  }
</style>
