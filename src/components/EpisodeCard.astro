---
import type { Episode } from '../lib/feed';
import { episodePath, url } from '../lib/urls';
import { formatDate, formatDuration } from '../lib/text';

interface Props {
  episode: Episode;
  headingLevel?: 'h2' | 'h3';
}
const { episode: ep, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="card card-link episode-card">
  <p class="eyebrow">Episode {ep.number} · <time datetime={ep.pubDate.toISOString()}>{formatDate(ep.pubDate)}</time></p>
  <Heading class="title"><a href={url(episodePath(ep))}>{ep.title}</a></Heading>
  <p class="summary">{ep.summary}</p>
  <p class="meta muted">
    {formatDuration(ep.durationSeconds)}
    {ep.transcript && <span class="tag">Transcript</span>}
    {ep.youtubeUrl && <span class="tag">Video</span>}
  </p>
</article>

<style>
  .episode-card {
    position: relative;
    padding: 1.15rem 1.25rem 1.05rem;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .episode-card:has(a:focus-visible) { outline: 2px solid var(--red); outline-offset: 2px; }
  .title { margin: 0; font-size: 1.12rem; }
  .title a { color: var(--text); text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .episode-card:hover .title a { color: var(--accent-text); }
  .summary { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .meta { margin: auto 0 0; padding-top: 0.4rem; font-size: 0.85rem; display: flex; gap: 0.5rem; align-items: center; }
</style>
