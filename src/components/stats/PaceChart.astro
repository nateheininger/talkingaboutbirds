---
// Running total of downloads through the year, one line per year, so this season can be compared
// with past seasons at the same date. The current year is the red line; past years are grays
// that get lighter with age. Hovering a week shows every year's total at that point.
import { fmt } from '../../lib/stats';

interface Series {
  year: number;
  points: [number, number][]; // [day of year, running total]
}
interface Props {
  series: Series[]; // oldest first; the last one is the current year
}
const { series } = Astro.props;

const W = 760;
const H = 280;
const m = { top: 16, right: 92, bottom: 28, left: 52 };
const w = W - m.left - m.right;
const h = H - m.top - m.bottom;
const max = Math.max(...series.flatMap((s) => s.points.map((p) => p[1])), 1);
const rawStep = max / 4;
const pow = 10 ** Math.floor(Math.log10(rawStep));
const step = [1, 2, 2.5, 5, 10].map((v) => v * pow).find((v) => v >= rawStep)!;
const top = Math.ceil(max / step) * step;
const x = (day: number) => m.left + ((day - 1) / 365) * w;
const y = (v: number) => m.top + h - (v / top) * h;
const ticks = Array.from({ length: Math.round(top / step) + 1 }, (_, i) => i * step);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthStarts = [1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335];

const current = series.at(-1)!;
const past = series.slice(0, -1).reverse(); // most recent past year first
const color = (s: Series) => (s === current ? 'current' : `past-${Math.min(past.indexOf(s) + 1, 3)}`);
const path = (s: Series) => s.points.map(([d, v], i) => `${i ? 'L' : 'M'}${x(d).toFixed(1)},${y(v).toFixed(1)}`).join('');
const end = current.points.at(-1)!;

// Hover bands, one per week: "Through Mar 9|2026: 3,210|2025: 2,900|…"
const weeks = series.reduce((a, s) => Math.max(a, s.points.length), 0);
const dateLabel = (day: number) => {
  const d = new Date(Date.UTC(2023, 0, day));
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
};
const bands = Array.from({ length: weeks }, (_, i) => {
  const day = Math.min((i + 1) * 7, 365);
  const lines = [current, ...past]
    .filter((s) => s.points[i])
    .map((s) => `${s.year}: ${fmt(s.points[i][1])}`);
  return { day, x0: x(i * 7 + 1), x1: x(Math.min((i + 1) * 7 + 1, 366)), tip: [`Through ${dateLabel(day)}`, ...lines].join('|') };
});
---

<ul class="legend" aria-label="Years">
  {[current, ...past].map((s) => <li><span class:list={['swatch', color(s)]} />{s.year}</li>)}
</ul>
<div class="chart-scroll">
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Running total of downloads through each year. The table below has the yearly numbers.">
    {
      ticks.map((t) => (
        <g>
          <line class="grid" x1={m.left} x2={W - m.right} y1={y(t)} y2={y(t)} />
          <text class="axis" x={m.left - 8} y={y(t) + 4} text-anchor="end">{fmt(t)}</text>
        </g>
      ))
    }
    {monthStarts.map((d, i) => <text class="axis" x={x(d) + 2} y={H - 8}>{MONTHS[i]}</text>)}
    {[...past].reverse().map((s) => <path class:list={['line', color(s)]} d={path(s)} />)}
    <path class="line current" d={path(current)} />
    <circle class="dot" cx={x(end[0])} cy={y(end[1])} r="4.5" />
    <text class="label" x={x(end[0]) + 8} y={y(end[1]) - 8}>{current.year}: {fmt(end[1])}</text>
    {
      bands.map((b) => (
        <g class="band" data-tip={b.tip}>
          <rect class="hit" x={b.x0} y={m.top} width={Math.max(1, b.x1 - b.x0)} height={h} />
          <line class="cross" x1={x(b.day)} x2={x(b.day)} y1={m.top} y2={m.top + h} />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .legend { list-style: none; padding: 0; margin: 0 0 0.5rem; display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
  .chart-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .chart { display: block; width: 100%; min-width: 560px; height: auto; font-family: var(--font-body); }
  .grid { stroke: var(--line); stroke-width: 1; }
  .axis { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .label { fill: var(--text); font-size: 12px; font-weight: 600; }
  .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .line.current { stroke-width: 2.5; }
  .current { stroke: var(--chart); background: var(--chart); }
  .past-1 { stroke: var(--yoy-1); background: var(--yoy-1); }
  .past-2 { stroke: var(--yoy-2); background: var(--yoy-2); }
  .past-3 { stroke: var(--yoy-3); background: var(--yoy-3); }
  .dot { fill: var(--chart); stroke: var(--surface); stroke-width: 2; }
  .hit { fill: transparent; }
  .cross { stroke: var(--muted); stroke-width: 1; opacity: 0; }
  .band:hover .cross { opacity: 0.6; }
</style>
